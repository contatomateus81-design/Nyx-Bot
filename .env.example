# Numero do WhatsApp usado para gerar o pairing code.
# Formato internacional, somente numeros, sem +, espacos ou hifens.
PHONE_NUMBER=

# Prefixo dos comandos
PREFIX=!

# Numero(s) do dono, separados por virgula, no mesmo formato internacional.
OWNER_NUMBERS=

# IA opcional. Nunca coloque esta chave diretamente no codigo ou no GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Modelo usado para transcrição de áudio.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Se true, o Nyx responde automaticamente em conversas privadas.
# Também pode ser ligado/desligado em tempo de execução com !modoia on/off.
AI_AUTO=false

# Arquivos persistentes da memoria e dos lembretes.
MEMORY_FILE=./sessions/nyx/memory.json
REMINDERS_FILE=./sessions/nyx/reminders.json
